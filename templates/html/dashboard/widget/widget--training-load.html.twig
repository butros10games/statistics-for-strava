{% autoescape false %}
    <div class="flex items-center justify-between gap-3 mb-5">
        <h3 class="text-lg font-semibold">{{ "Training Load Analysis"|trans }}</h3>
        <div class="flex items-center gap-2">
            <a href="{{ relativeUrl('api/exports/training-advisor.json') }}" download="training-advisor.json"
               class="shrink-0 inline-flex items-center gap-2 rounded-lg border border-blue-200 px-3 py-2 text-sm font-medium text-blue-700 hover:bg-blue-50">
                {{ "Export for AI feedback"|trans }}
            </a>
            <a href="#" data-model-content-url="{{ relativeUrl('training-load.html') }}"
               class="shrink-0 inline-flex items-center p-2 text-sm font-medium rounded-lg text-blue-600 hover:bg-gray-100">
                {{ "View details"|trans }}
            </a>
        </div>
    </div>
    {% set guidanceToneClasses = {
        'good': 'border-l-green-600 bg-green-50',
        'neutral': 'border-l-blue-600 bg-blue-50',
        'caution': 'border-l-amber-500 bg-amber-50',
        'danger': 'border-l-red-600 bg-red-50'
    } %}
    {% set guidanceSignalClasses = {
        'good': 'bg-green-100 text-green-800',
        'neutral': 'bg-blue-100 text-blue-800',
        'caution': 'bg-amber-100 text-amber-900',
        'danger': 'bg-red-100 text-red-800'
    } %}
    <div class="mb-4 rounded-xl border border-gray-200 border-l-4 p-4 shadow-xs {{ guidanceToneClasses[dailyTrainingGuidance.getTone()] ?? guidanceToneClasses.neutral }}">
        <div class="flex flex-col gap-3 lg:flex-row lg:items-start lg:justify-between">
            <div class="min-w-0">
                <div class="text-[11px] font-semibold uppercase tracking-wide text-gray-500">{{ "Today's guidance"|trans }}</div>
                <div class="mt-1 text-lg font-semibold text-gray-900">{{ dailyTrainingGuidance.getTitle()|trans }}</div>
                <p class="mt-1 text-sm text-gray-600">{{ dailyTrainingGuidance.getSummary()|trans }}</p>
            </div>
            <div class="flex flex-wrap gap-1.5 lg:max-w-md lg:justify-end">
                {% for signal in dailyTrainingGuidance.getSignals() %}
                    <span class="inline-flex items-center gap-1 rounded-full px-2.5 py-1 text-xs font-medium {{ guidanceSignalClasses[signal.tone] ?? guidanceSignalClasses.neutral }}">
                        <span class="text-[10px] uppercase tracking-wide opacity-70">{{ signal.label|trans }}</span>
                        <span>{{ signal.value|trans }}</span>
                    </span>
                {% endfor %}
            </div>
        </div>
    </div>
    {% include 'html/dashboard/training-metrics.html.twig' with {
        'trainingMetrics': trainingMetrics,
        'timeInHeartRateZonesForLast30Days': timeInHeartRateZonesForLast30Days,
        'context': 'page'
    } %}
    <div class="mt-4">
        {% include 'html/dashboard/recovery-check-in-summary.html.twig' with {
            'context': 'page',
            'latestRecoveryCheckIn': latestRecoveryCheckIn,
            'latestRecoveryCheckInOverall': latestRecoveryCheckInOverall,
            'shouldAutoOpenRecoveryCheckIn': shouldPromptRecoveryCheckIn
        } %}
    </div>
{% endautoescape %}
